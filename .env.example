# ------------------------------------------------------------------
# Environment template for the Simple E-commerce Catalogue (1-7).
# Copy this file to ".env" and change the values:   cp .env.example .env
# NEVER commit the real ".env" file - it is listed in .gitignore.
# ------------------------------------------------------------------

# --- PostgreSQL database ---
POSTGRES_DB=catalogue_db
POSTGRES_USER=catalogue_user
POSTGRES_PASSWORD=change_me_db_password

# Host port for connecting to PostgreSQL from your computer (psql, DBeaver).
# The containers themselves always talk to the database on port 5432.
DB_HOST_PORT=5433

# --- Backend (FastAPI) ---
# Host port where the API is published directly (useful for debugging).
BACKEND_PORT=8000
# Long random string used to sign login tokens. Generate one, for example:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_string
# How long a login token stays valid (minutes)
TOKEN_TTL_MINUTES=120
# Allowed browser origins (comma separated) for CORS
CORS_ORIGINS=http://localhost:8080

# Demo account passwords. They are set for the seeded demo users
# (admin@example.local and staff@example.local) on the first backend start.
# Use fake demo values only - never a real password you use elsewhere.
DEMO_ADMIN_PASSWORD=change_me_admin_demo
DEMO_STAFF_PASSWORD=change_me_staff_demo

# --- Frontend (nginx) ---
FRONTEND_PORT=8080
